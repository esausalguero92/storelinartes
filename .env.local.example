# ─── Zora.gt Environment Variables ──────────────────────────────────────────
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to version control

# Site
NEXT_PUBLIC_SITE_URL=https://zora.gt
NEXT_PUBLIC_SITE_NAME=Zora.gt

# WhatsApp
NEXT_PUBLIC_WHATSAPP_NUMBER=50212345678
NEXT_PUBLIC_WHATSAPP_DEFAULT_MSG=Hola, me interesa saber más sobre sus productos.

# Contact Email (used in footer/contact page)
NEXT_PUBLIC_CONTACT_EMAIL=hola@zora.gt

# Social Media
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/zora.gt?igsh=ODhnMThtbzdoMXhs
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@_zora.gt?_r=1&_t=ZS-96Yrjc7UPbx
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/share/183GH5AWAt/

# Precios (server-side, sin prefijo NEXT_PUBLIC — nunca expuestos al cliente)
# Si no se definen, se usan los valores por defecto del codigo
PRICE_TARRO=150
PRICE_TARRO_ORIGINAL=200
PRICE_AHUMADOR=450
PRICE_AHUMADOR_ORIGINAL=599
PRICE_CAFE=175
PRICE_CAFE_ORIGINAL=249

# Analytics (optional - add when ready)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_PIXEL_ID=XXXXXXXXXX
