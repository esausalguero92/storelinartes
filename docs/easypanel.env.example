# ═══════════════════════════════════════════════════════════════════════════
# Variables para Easypanel → servicio storelinartes → Entorno
# Copiar, llenar los valores y pegar. NUNCA subir este archivo con valores reales.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Servidor ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── Sitio (mismo dominio configurado en Easypanel → Dominios) ──────────────
SITE_URL=https://linartes.com
NEXT_PUBLIC_SITE_URL=https://linartes.com
ALLOWED_ORIGINS=https://www.linartes.com
TRUSTED_PROXY_HOPS=1

# ─── Públicas (opcionales: si faltan se usan los valores de Linartes) ───────
NEXT_PUBLIC_WHATSAPP_NUMBER=50238606934
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/linartes_design/
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/linartesDesign/
NEXT_PUBLIC_CONTACT_EMAIL=

# ─── Precios (quetzales) ────────────────────────────────────────────────────
PRICE_SET_REGALO_PREMIUM=350
PRICE_KIT_CORPORATIVO=150
PRICE_MARCO_GIRATORIO_360=295
PRICE_KIT_DAMAS_DE_HONOR=225

# ─── Compra en línea (dejar false hasta tener todo lo de abajo) ─────────────
CHECKOUT_ENABLED=false
SHIPPING_CITY_GTQ=0
SHIPPING_INTERIOR_GTQ=0
ORDER_MAX_UNITS=10
ORDER_EXPIRY_MINUTES=60

# Supabase → Project Settings → Database → Connection string → Session pooler
DATABASE_URL=

# Recurrente (llave live en producción) y secreto del webhook (whsec_…)
RECURRENTE_SECRET_KEY=
RECURRENTE_WEBHOOK_SECRET=

# Cloudflare Turnstile (anti-bots). En producción debe estar activo.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_DISABLED=false

# Telegram (bot del equipo Linartes)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_TEAM_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ADMIN_USER_IDS=

# Correo
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Linartes <notificaciones@linartes.com>
MAIL_TEAM_TO=

# Cron: secreto para /api/cron/notifications (inventar 32+ caracteres)
CRON_SECRET=
